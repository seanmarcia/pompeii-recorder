<% # The review page's inline photo-selection and inline-edit scripts own
   # this page — Turbo never drives it until they are ported to Stimulus
   # (follow-up; issue #76). Block form: content_for escapes plain strings. %>
<% content_for :body_attributes do %>data-turbo="false"<% end %>
<style>
  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .back-link:hover { color: var(--text); }
  .detail-title {
    font-size: 1.6rem;
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .review-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 960px) {
    .review-layout { grid-template-columns: 1fr; }
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .card-title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
  table.diff-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  table.diff-table th {
    padding: 0.6rem 0.75rem;
    background: var(--surface-elevated);
    color: var(--text-muted);
    text-align: left;
    font-size: 0.75rem;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
  }
  table.diff-table td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .changed-row {
    background: rgba(227, 179, 65, 0.08);
  }
  .val-old {
    color: var(--danger);
    background: rgba(179, 57, 42, 0.12);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.85rem;
  }
  .val-new {
    color: var(--success);
    background: rgba(79, 121, 66, 0.14);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.85rem;
  }
  .val-unchanged {
    color: var(--text-muted);
    font-family: monospace;
    font-size: 0.85rem;
  }
  .diff-text {
    color: var(--text);
    font-family: monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
  }
  .diff-removed {
    color: var(--danger);
    background: rgba(179, 57, 42, 0.18);
    text-decoration: line-through;
    border-radius: 3px;
  }
  .diff-added {
    color: var(--success);
    background: rgba(79, 121, 66, 0.2);
    border-radius: 3px;
  }
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .photo-box {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-elevated);
  }
  .photo-box img {
    max-width: 100%;
    max-height: 240px;
    width: auto;
    height: auto;
    display: block;
  }
  /* A hidden master photo dims in place here too: same treatment as the
     master sheet page, so the hidden state is unmistakable at a glance
     (issue #66). */
  .photo-box img.photo-hidden {
    opacity: 0.3;
    filter: grayscale(0.8);
  }
  .photo-caption {
    padding: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    background: var(--surface-elevated);
  }
  .photo-missing {
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--border);
    background: var(--bg);
    color: var(--text-muted);
    font-size: 0.75rem;
    text-align: center;
    padding: 0 0.75rem;
  }
  .photo-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  /* A new-sheet submission has no comparison column: the proposed column
     takes the full width instead of half of an empty grid. */
  .photo-compare:has(> :only-child) { grid-template-columns: 1fr; }
  @media (max-width: 760px) {
    .photo-compare { grid-template-columns: 1fr; }
  }
  .compare-col-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .compare-col-head .col-count {
    font-weight: 400;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .compare-selection {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: -0.25rem 0 0.6rem;
  }
  .compare-empty {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .photo-box .pick-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.78rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }
  .photo-flag {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.45rem 0.6rem;
    background: rgba(179, 57, 42, 0.12);
    color: var(--danger);
  }
  .photo-flag.echo {
    background: rgba(227, 179, 65, 0.15);
    color: var(--pending);
  }
  /* A deselected photo grays out on the spot: pure CSS off the checkbox
     state, no client logic. */
  .photo-box:has(input[type="checkbox"]:not(:checked)) img,
  .photo-box:has(input[type="checkbox"]:not(:checked)) .photo-missing {
    filter: grayscale(1);
    opacity: 0.45;
  }
  .action-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .form-group textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    padding: 0.75rem;
    font-family: inherit;
    font-size: 0.875rem;
    resize: vertical;
    min-height: 80px;
  }
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .val-plain {
    color: var(--text);
    font-family: monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
  }
  .changed-flag {
    color: var(--pending);
    font-size: 0.75rem;
    display: block;
  }
  .field-hint {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .section-row td {
    background: var(--surface-elevated);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.45rem 0.75rem;
  }
  .edit-hint {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .value-cell { position: relative; }
  .value-cell.editable {
    cursor: text;
    padding-right: 2rem;
    border-radius: 4px;
    outline: 1px dashed transparent;
    outline-offset: -4px;
    transition: background 0.12s ease, outline-color 0.12s ease;
  }
  .value-cell.editable:hover,
  .value-cell.editable:focus {
    background: rgba(165, 114, 63, 0.08);
    outline-color: var(--accent);
  }
  .edit-icon {
    position: absolute;
    top: 0.75rem;
    right: 0.6rem;
    color: var(--accent);
    opacity: 0.35;
  }
  .value-cell.editable:hover .edit-icon,
  .value-cell.editable:focus .edit-icon { opacity: 1; }
  .value-cell.editing { background: transparent; outline-color: transparent; }
  .value-cell.editing .edit-icon { display: none; }
  .value-cell.saving { opacity: 0.5; }
  .inline-editor {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--text);
    padding: 0.4rem 0.5rem;
    font-family: monospace;
    font-size: 0.85rem;
  }
  textarea.inline-editor { min-height: 110px; resize: vertical; }
  .inline-editor:focus { outline: 2px solid rgba(165, 114, 63, 0.35); }
  .editor-help {
    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }
  .editor-error {
    display: block;
    font-size: 0.75rem;
    color: var(--danger);
    margin-top: 0.3rem;
  }
  .row-saved { animation: row-saved 1.2s ease; }
  @keyframes row-saved {
    from { background: rgba(79, 121, 66, 0.25); }
  }
  .filter-toggle {
    font-size: 0.8rem;
    font-weight: normal;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    text-transform: none;
    letter-spacing: 0;
    cursor: pointer;
  }
  .only-changed tr.field-row:not(.changed-row),
  .only-changed tr.section-row { display: none; }
</style>

<div>
  <a href="/admin" class="back-link">&larr; Back to Submissions Queue</a>
  <% if @read_only %>
    <p>Read-only sheet view. No edits or review actions are enabled.</p>
    <% if @submission.status == "pending" %>
      <%= link_to "Review / Edit Submission", admin_submission_path(@submission), class: "btn btn-outline" %>
    <% end %>
  <% else %>
    <%= link_to "View Sheet (Read Only)", admin_submission_path(@submission, mode: "view"), class: "btn btn-outline" %>
  <% end %>
  <% if @master %>
    <%= link_to "View Master Sheet", admin_feature_path(@master.sheet), class: "btn btn-outline" %>
  <% end %>

  <div class="detail-header">
    <div>
      <div class="detail-title">
        Submission #<%= @submission.id %>
        <% if @submission.action_type == "create_new" %>
          <span class="badge badge-new">New Room Record</span>
        <% else %>
          <span class="badge badge-update">Update Existing Record</span>
        <% end %>
        <span class="badge badge-<%= @submission.status %>"><%= @submission.status %></span>
      </div>
      <p style="color: var(--text-muted); margin-top: 0.35rem; font-size: 0.9rem;">
        Target Sheet: <strong><%= @submission.sheet_number || "Unspecified" %></strong> &bull;
        Submitted <%= @submission.created_at.strftime("%B %d, %Y at %H:%M UTC") %>
      </p>
    </div>
  </div>

  <% if @submission.status == "pending" && (others = @submission.other_pending_for_sheet.to_a).any? %>
    <div class="flash flash-info">
      <%= others.size == 1 ? "Another pending submission exists" : "#{others.size} other pending submissions exist" %>
      for Sheet <%= @submission.sheet_number %>:
      <% others.each_with_index do |other, i| %><%= ", " if i > 0 %><a href="<%= admin_submission_path(other) %>">#<%= other.id %> from <%= other.submitter_name.presence || "Anonymous" %></a><% end %>.
      Approve each one to merge them into the sheet. Fields left blank never erase what's already there.
    </div>
  <% end %>

  <div class="review-layout">
    <!-- LEFT: Diff / Field Breakdown -->
    <div class="main-column">
      <div class="card">
        <div class="card-title">
          <span>Archaeological Field Data &bull; <%= @diff[:is_new] ? "New Record Values" : "Submitted vs. Master" %></span>
          <% unless @diff[:is_new] %>
            <label class="filter-toggle">
              <input type="checkbox" id="only-changed-toggle">
              <span>Changed only (<span id="changed-count"><%= @submission.changed_field_count %></span>)</span>
            </label>
          <% end %>
        </div>

        <% if @submission.status == "pending" && !@read_only %>
          <p class="edit-hint">&#9998; Click any value to correct it or fill in a missed detail. Changes save automatically.</p>
        <% end %>

        <table class="diff-table" id="field-table" data-update-url="<%= admin_submission_path(@submission) %>">
          <thead>
            <tr>
              <th style="width: 25%;">Field</th>
              <% unless @diff[:is_new] %>
                <th style="width: 35%;">Current Master Value</th>
              <% end %>
              <th>Submitted Value</th>
            </tr>
          </thead>
          <tbody>
            <% Submission::EDITABLE_FIELDS.each do |section, fields| %>
              <tr class="section-row"><td colspan="<%= @diff[:is_new] ? 2 : 3 %>"><%= section %></td></tr>
              <% fields.each do |key, label| %>
                <%= render "field_row", submission: @submission, key: key, label: label, is_new: @diff[:is_new], read_only: @read_only %>
              <% end %>
            <% end %>
            <% extra_keys = @payload.keys - Submission::EDITABLE_FIELDS.values.flat_map(&:keys) - ["photos", Submission::DEFAULTS_KEY] %>
            <% if extra_keys.any? %>
              <tr class="section-row"><td colspan="<%= @diff[:is_new] ? 2 : 3 %>">Other Submitted Values</td></tr>
              <% extra_keys.each do |key| %>
                <tr class="field-row">
                  <td><strong><%= key %></strong></td>
                  <% unless @diff[:is_new] %><td></td><% end %>
                  <td><span class="val-plain"><%= @payload[key].presence || "empty" %></span></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Photos Section: the sheet's photos beside this submission's, so a
           duplicate is visible before approval. Counts live in the column
           heads, not the card title, so each side states its own size. -->
      <div class="card">
        <div class="card-title">
          <span>Attached Photos</span>
        </div>

        <% proposed_items = @submission.photo_review_items %>
        <% if proposed_items.empty? %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">No photos attached to this submission.</p>
        <% else %>
          <div class="photo-compare">
            <% if @master %>
              <div class="compare-col compare-sheet">
                <div class="compare-col-head">
                  <span>On the sheet now</span>
                  <span class="col-count"><%= pluralize(@master.photo_items.size, "photo") %></span>
                </div>
                <% if @master.photo_items.any? %>
                  <div class="photos-grid">
                    <% @master.photo_items.each do |item| %>
                      <div class="photo-box">
                        <% if item[:attachment] %>
                          <%= image_tag item[:attachment], alt: item[:name], **photo_dimension_attributes(item[:attachment]), class: ("photo-hidden" if item[:hidden]) %>
                        <% else %>
                          <div class="photo-missing"><span>No image on file</span></div>
                        <% end %>
                        <div class="photo-caption"><%= item[:name] %></div>
                        <% # Hidden master photos stay visible here, annotated:
                           # a reviewer approving a same-named photo deserves
                           # to know an admin already hid one (issue #66).
                           %>
                        <% if item[:hidden] %>
                          <div class="photo-flag echo">Hidden by <%= item[:hidden_by] || "an admin" %></div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <p class="compare-empty">No photos on the sheet yet.</p>
                <% end %>
              </div>
            <% end %>
            <div class="compare-col compare-proposed">
              <div class="compare-col-head">
                <span>Proposed by this submission</span>
                <% already_count = proposed_items.count { |i| i[:name_on_sheet] || i[:bytes_on_sheet] } %>
                <span class="col-count">
                  <%= pluralize(proposed_items.size, "photo") %><%= " · #{already_count} already on sheet" if already_count > 0 %>
                </span>
              </div>
              <% # A live tally of the reviewer's decision — hidden when there is
                 # nothing to decide (read-only, reviewed, no selectable cards). %>
              <% decision_count = (@submission.status == "pending" && !@read_only && @submission.payload["photos"].is_a?(Array)) ? proposed_items.count { |i| i[:own_bytes] ? (!i[:bytes_on_sheet] && !i[:dup_of_proposed]) : !i[:name_on_sheet] } : 0 %>
              <% if decision_count > 0 %>
                <p class="compare-selection" id="proposed-selection-summary"><%= decision_count %> included on approval</p>
              <% end %>
              <div class="photos-grid">
                <% proposed_items.each do |item| %>
                  <% # Controls only for a payload the merge will actually read:
                     # a legacy submission without a photos key never merges
                     # its attachment names, so they are display-only. Three
                     # kinds of card are no-ops on approval and get no
                     # checkbox: a pure echo (name already on the sheet, no
                     # bytes behind it here), a byte-identical duplicate of
                     # what the sheet serves, and a duplicate of another
                     # proposed photo (approval joins only the first copy).
                     # Every other byte-carrying card is a real decision: it
                     # joins the sheet as its own row on approval, or the
                     # reviewer declines it.
                     selectable = @submission.status == "pending" && !@read_only &&
                       @submission.payload["photos"].is_a?(Array) &&
                       (item[:own_bytes] ? (!item[:bytes_on_sheet] && !item[:dup_of_proposed]) : !item[:name_on_sheet]) %>
                  <div class="photo-box">
                    <% if item[:attachment] %>
                      <%= image_tag item[:attachment], alt: item[:name], **photo_dimension_attributes(item[:attachment]) %>
                    <% else %>
                      <div class="photo-missing"><span>No image on file</span></div>
                    <% end %>
                    <div class="photo-caption">
                      <% if item[:attachment] %><%= number_to_human_size(item[:attachment].byte_size) %> &bull; <% end %>
                      <%= item[:name] %>
                    </div>
                    <% if item[:excluded] %>
                      <div class="photo-flag">dropped by the reviewer</div>
                    <% elsif item[:name_on_sheet] %>
                      <div class="photo-flag echo">image with name already on sheet</div>
                    <% elsif item[:bytes_on_sheet] %>
                      <div class="photo-flag">identical image already on sheet</div>
                    <% elsif item[:dup_of_proposed] %>
                      <div class="photo-flag">identical to another proposed photo</div>
                    <% end %>
                    <% if selectable && !item[:excluded] %>
                      <% # The key names the individual photo: byte-carrying
                         # cards exclude by attachment blob, name-only
                         # proposals (no bytes) by name. Two same-named
                         # photos are two independent decisions.
                         exclude_key = item[:own_bytes] ? "blob:#{item[:attachment].blob_id}" : "name:#{item[:name]}" %>
                      <label class="pick-row">
                        <input type="checkbox" data-photo-key="<%= exclude_key %>" checked>
                        <span>Add to sheet on approval</span>
                      </label>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- RIGHT: Submitter info and Approval actions -->
    <div class="sidebar-column">
      <div class="card">
        <div class="card-title">Submitter Information</div>
        <div style="display: flex; flex-direction: column; gap: 0.8rem; font-size: 0.88rem;">
          <div>
            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Your Name / Data Entered By</div>
            <div style="font-weight: 600; color: var(--text);"><%= @submission.submitter_name.presence || "Field Researcher" %></div>
          </div>
          <div>
            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Field Notes</div>
            <div style="margin-top: 0.2rem; background: var(--surface-elevated); padding: 0.6rem; border-radius: var(--radius); font-style: italic;">
              <%= @submission.submitter_notes.presence || "None provided" %>
            </div>
          </div>
          <div>
            <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Status</div>
            <div style="margin-top: 0.2rem;">
              <span class="badge badge-<%= @submission.status %>"><%= @submission.status.upcase %></span>
            </div>
          </div>
          <% if @submission.reviewed_at %>
            <div>
              <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Reviewed Date</div>
              <div style="font-size: 0.8rem;"><%= @submission.reviewed_at.strftime("%B %d, %Y %H:%M") %></div>
            </div>
          <% end %>
          <% if @submission.reviewer_notes.present? %>
            <div>
              <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">Reviewer Notes</div>
              <div style="margin-top: 0.2rem; background: var(--surface-elevated); padding: 0.6rem; border-radius: var(--radius);">
                <%= @submission.reviewer_notes %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Action Box -->
      <div class="card" style="border-color: <%= @submission.status == 'pending' ? 'var(--pending)' : 'var(--border)' %>;">
        <div class="card-title">Curation Actions</div>
        <% if @submission.status == "pending" && !@read_only %>
          <div class="action-form">
            <%= form_with url: approve_admin_submission_path(@submission), method: :post do |f| %>
              <input type="hidden" name="exclude_photos" id="exclude-photos-field" value="[]">
              <div class="form-group" style="margin-bottom: 1rem;">
                <label>Approval Comment (Optional)</label>
                <textarea name="reviewer_notes" placeholder="e.g., Verified against 2011 excavation diary. Approved for catalog."></textarea>
              </div>
              <button type="submit" class="btn btn-success" style="width: 100%; justify-content: center;">
                &#10003; Approve &amp; Merge to Master
              </button>
            <% end %>

            <div style="text-align: center; margin: 0.5rem 0; color: var(--text-muted); font-size: 0.8rem;">or</div>

            <%= form_with url: reject_admin_submission_path(@submission), method: :post do |f| %>
              <div class="form-group" style="margin-bottom: 1rem;">
                <label>Rejection Reason</label>
                <textarea name="reviewer_notes" placeholder="e.g., Space number conflicts with published insula survey." required></textarea>
              </div>
              <button type="submit" class="btn btn-danger" style="width: 100%; justify-content: center;">
                &#10007; Reject Submission
              </button>
            <% end %>
          </div>
        <% elsif @submission.status != "pending" %>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            This submission has already been <strong><%= @submission.status %></strong>.
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @submission.status == "pending" && !@read_only %>
<script>
  (function () {
    const table = document.getElementById("field-table");
    if (!table || table.dataset.inlineEditBound) return;
    table.dataset.inlineEditBound = "true";
    const url = table.dataset.updateUrl;
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content;

    function startEdit(cell) {
      if (cell.classList.contains("editing")) return;
      const kind = cell.dataset.kind;
      const original = cell.dataset.value || "";
      const display = cell.querySelector(".value-display");
      let editor;

      if (kind === "boolean" || kind === "category") {
        editor = document.createElement("select");
        const options = kind === "category"
          ? [["", "Select Category"], ...JSON.parse(cell.dataset.options).map(value => [value, value])]
          : [["T", "True (T)"], ["F", "False (F)"]];
        const selected = kind === "boolean" ? original || "F" : original;
        if (kind === "category" && original && !options.some(([value]) => value === original)) {
          const legacy = new Option(`Current: ${original}`, original, true, true);
          legacy.hidden = true;
          legacy.disabled = true;
          editor.add(legacy);
        }
        options.forEach(([v, text]) => {
          const opt = new Option(text, v);
          opt.selected = selected === v;
          editor.add(opt);
        });
      } else if (kind === "textarea") {
        editor = document.createElement("textarea");
        editor.value = original;
      } else {
        editor = document.createElement("input");
        editor.type = "text";
        editor.value = original;
      }
      editor.className = "inline-editor";

      const help = document.createElement("span");
      help.className = "editor-help";
      help.textContent = kind === "textarea"
        ? "Ctrl/⌘ + Enter to save · Esc to cancel"
        : "Enter to save · Esc to cancel";

      display.hidden = true;
      cell.classList.add("editing");
      cell.append(editor, help);
      editor.focus();
      // Caret at the end rather than select-all, so a stray keystroke can't
      // wipe a long description.
      if (editor.tagName !== "SELECT") editor.setSelectionRange(editor.value.length, editor.value.length);

      let done = false;
      const finish = (save) => {
        if (done) return;
        done = true;
        if (!save || editor.value === original) {
          editor.remove();
          help.remove();
          display.hidden = false;
          cell.classList.remove("editing");
          cell.focus();
          return;
        }
        save_(cell, editor.value, () => {
          done = false;
        });
      };

      editor.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          finish(false);
        } else if (e.key === "Enter" && (kind !== "textarea" || e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          finish(true);
        }
      });
      editor.addEventListener("blur", () => finish(true));
      if (kind === "boolean" || kind === "category") editor.addEventListener("change", () => finish(true));
    }

    function save_(cell, value, onError) {
      const row = cell.closest("tr");
      const key = row.dataset.field;
      cell.classList.add("saving");
      cell.querySelector(".editor-error")?.remove();

      fetch(url, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          ...(csrf ? { "X-CSRF-Token": csrf } : {}),
        },
        body: JSON.stringify({ fields: { [key]: value } }),
      })
        .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
        .then(({ ok, data }) => {
          if (!ok) throw new Error(data.error || "Could not save");
          const tmp = document.createElement("tbody");
          tmp.innerHTML = data.rows[key].trim();
          const newRow = tmp.firstElementChild;
          row.replaceWith(newRow);
          newRow.classList.add("row-saved");
          newRow.querySelector(".value-cell")?.focus();
          const count = document.getElementById("changed-count");
          if (count) count.textContent = data.changed_count;
        })
        .catch((err) => {
          cell.classList.remove("saving");
          const msg = document.createElement("span");
          msg.className = "editor-error";
          msg.textContent = err.message + " — try again or press Esc.";
          cell.append(msg);
          cell.querySelector(".inline-editor")?.focus();
          onError();
        });
    }

    table.addEventListener("click", (e) => {
      const cell = e.target.closest(".value-cell.editable");
      if (cell && !e.target.closest(".inline-editor")) startEdit(cell);
    });
    table.addEventListener("keydown", (e) => {
      const cell = e.target.closest(".value-cell.editable");
      if (cell && e.target === cell && (e.key === "Enter" || e.key === "F2")) {
        e.preventDefault();
        startEdit(cell);
      }
    });
  })();

  // Photo selection sync: the include/exclude checkboxes ride the approve
  // POST as a JSON list of excluded photo keys ("blob:<id>" for a
  // byte-carrying photo, "name:<filename>" for a name-only proposal).
  // Nothing is written until the reviewer approves, matching how the rest
  // of the approval state flows. The column-head tally (N included on
  // approval · M dropped) tracks the same checkboxes so the decision is
  // visible where the photos live. Each checkbox is its own decision — two
  // same-named photos exclude independently.
  (function () {
    const excludeField = document.getElementById("exclude-photos-field");
    if (!excludeField) return;
    const summary = document.getElementById("proposed-selection-summary");
    const selectionBoxes = () => Array.from(document.querySelectorAll("input[type='checkbox'][data-photo-key]"));
    const syncExclusions = () => {
      excludeField.value = JSON.stringify(selectionBoxes().filter((box) => !box.checked).map((box) => box.dataset.photoKey));
    };
    const syncSummary = () => {
      if (!summary) return;
      const boxes = selectionBoxes();
      const included = boxes.filter((box) => box.checked).length;
      const dropped = boxes.length - included;
      summary.textContent = dropped === 0
        ? `${included} included on approval`
        : `${included} of ${boxes.length} included on approval · ${dropped} dropped`;
    };
    document.addEventListener("change", (event) => {
      if (event.target instanceof HTMLInputElement && event.target.matches("input[type='checkbox'][data-photo-key]")) {
        syncExclusions();
        syncSummary();
      }
    });
    syncExclusions();
    syncSummary();
  })();
</script>
<% end %>

<% unless @diff[:is_new] %>
<script>
  (function () {
    const toggle = document.getElementById("only-changed-toggle");
    const table = document.getElementById("field-table");
    if (toggle && table) toggle.addEventListener("change", () => table.classList.toggle("only-changed", toggle.checked));
  })();
</script>
<% end %>
