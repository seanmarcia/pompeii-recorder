<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    overflow: hidden;
  }
  .stat-card.active-pending {
    border-color: var(--pending);
    box-shadow: 0 0 20px rgba(227, 179, 65, 0.1);
  }
  .stat-card .label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .stat-card .value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    font-family: var(--font-serif);
  }
  .tabs-nav {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .tab-link {
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.9rem;
    border-bottom: 2px solid transparent;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tab-link.active {
    color: var(--text);
    border-bottom-color: var(--terracotta);
  }
  .table-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  table.submissions-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }
  table.submissions-table th {
    background: var(--surface-elevated);
    padding: 0.85rem 1rem;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border);
  }
  table.submissions-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  table.submissions-table tr:hover td {
    background: var(--surface-elevated);
  }
  .cell-title {
    font-weight: 600;
    color: var(--text);
  }
  .cell-sub {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    color: var(--text-muted);
  }
  .empty-state-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.6;
  }
  .queue-search {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .queue-search input[type="search"] {
    flex: 1;
    max-width: 420px;
    min-width: 220px;
    padding: 0.65rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.9rem;
  }
  .queue-search .result-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  table.submissions-table th a {
    color: inherit;
    text-decoration: none;
  }
</style>

<div class="stats-grid">
  <div class="stat-card <%= 'active-pending' if @counts[:pending] > 0 %>">
    <span class="label">Pending Review</span>
    <span class="value" style="color: var(--pending);"><%= @counts[:pending] %></span>
    <span class="cell-sub">Awaiting admin curation</span>
  </div>
  <div class="stat-card">
    <span class="label">Approved &amp; Merged</span>
    <span class="value" style="color: var(--success);"><%= @counts[:approved] %></span>
    <span class="cell-sub">Added to master catalog</span>
  </div>
  <div class="stat-card">
    <span class="label">Master Catalog Rooms</span>
    <span class="value"><%= Feature.count %></span>
    <span class="cell-sub">Verified Pompeii records</span>
  </div>
</div>

<nav class="tabs-nav">
  <a href="<%= queue_url("status" => "pending") %>" class="tab-link <%= 'active' if @filter == 'pending' %>">
    Pending Queue (<%= @counts[:pending] %>)
  </a>
  <a href="<%= queue_url("status" => "approved") %>" class="tab-link <%= 'active' if @filter == 'approved' %>">
    Approved (<%= @counts[:approved] %>)
  </a>
  <a href="<%= queue_url("status" => "rejected") %>" class="tab-link <%= 'active' if @filter == 'rejected' %>">
    Rejected (<%= @counts[:rejected] %>)
  </a>
  <a href="<%= queue_url("status" => "all") %>" class="tab-link <%= 'active' if @filter == 'all' %>">
    All History (<%= @counts[:total] %>)
  </a>
</nav>

<form action="/admin" method="get" class="queue-search">
  <input type="hidden" name="status" value="<%= @filter %>">
  <input type="hidden" name="sort" value="<%= @sort %>">
  <input type="hidden" name="dir" value="<%= @dir %>">
  <input type="search" name="q" value="<%= @query %>" placeholder="Search by sheet number or researcher name&hellip;" aria-label="Search the queue">
  <button type="submit" class="btn btn-outline">Search</button>
  <% if @query.present? %>
    <a href="<%= queue_url("q" => nil) %>" class="btn btn-outline">Clear</a>
    <span class="result-note"><%= @submissions.length %> result<%= "s" if @submissions.length != 1 %></span>
  <% end %>
</form>

<div class="table-card">
  <% if @submissions.empty? %>
    <div class="empty-state">
      <div class="empty-state-icon">&#9782;</div>
      <% if @query.present? %>
        <h3>No <%= @filter %> submissions match &ldquo;<%= @query %>&rdquo;</h3>
        <p style="margin-top: 0.5rem; font-size: 0.9rem;">
          Try a different sheet number or researcher name, or clear the search to see the whole queue.
        </p>
      <% else %>
        <h3>No <%= @filter %> submissions in queue</h3>
        <p style="margin-top: 0.5rem; font-size: 0.9rem;">
          When field archaeologists submit new room logs or updates from the client app, they will appear here for review.
        </p>
      <% end %>
    </div>
  <% else %>
    <table class="submissions-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Type</th>
          <th><%= queue_sort_link "Sheet / Location", "sheet" %></th>
          <th>Room / Structure</th>
          <th><%= queue_sort_link "Researcher (PR)", "researcher" %></th>
          <th>Photos</th>
          <th><%= queue_sort_link "Submitted", "submitted" %></th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |sub| %>
          <% payload = sub.payload %>
          <tr>
            <td>
              <span style="font-family: monospace; font-weight: bold;">#<%= sub.id %></span>
            </td>
            <td>
              <% if sub.action_type == "create_new" %>
                <span class="badge badge-new">New Room</span>
              <% else %>
                <span class="badge badge-update">Update</span>
              <% end %>
            </td>
            <td>
              <div class="cell-title">Sheet <%= sub.sheet_number || "—" %></div>
              <div class="cell-sub">
                Reg <%= sub.editable_value("REGION").presence || "—" %> &bull; Ins <%= sub.editable_value("INSULA").presence || "—" %> &bull; Ent <%= sub.editable_value("ENTRANCE").presence || "—" %>
              </div>
              <% if sub.status == "pending" && @pending_per_sheet[sub.target_sheet].to_i > 1 %>
                <span class="badge badge-shared" title="Several people sent in this sheet. Review each one; approving merges them.">
                  <%= @pending_per_sheet[sub.target_sheet] %> pending for this sheet
                </span>
              <% end %>
            </td>
            <td>
              <div class="cell-title"><%= sub.editable_value("SPACE_NUMBER").presence || sub.editable_value("STRUCTURE_ID").presence || "Untitled Space" %></div>
              <div class="cell-sub"><%= sub.editable_value("FEATURE_TYPE_ID").presence || sub.editable_value("SHEET_TYPE_ID").presence || "Record" %></div>
            </td>
            <td class="pr-cell">
              <div class="cell-title"><%= sub.researcher_name || "—" %></div>
            </td>
            <td>
              <% photo_count = sub.photos.attached? ? sub.photos.count : (payload["photos"]&.size || 0) %>
              <% if photo_count > 0 %>
                <span style="font-size: 0.85rem;">📷 <%= photo_count %></span>
              <% else %>
                <span style="color: var(--text-muted); font-size: 0.85rem;">—</span>
              <% end %>
            </td>
            <td>
              <div class="cell-sub"><%= time_ago_in_words(sub.created_at) %> ago</div>
            </td>
            <td>
              <span class="badge badge-<%= sub.status %>"><%= sub.status %></span>
            </td>
            <td>
              <%= link_to "View Sheet", admin_submission_path(sub, mode: "view"), class: "btn btn-outline" %>
              <a href="/admin/submissions/<%= sub.id %>" class="btn btn-outline" style="padding: 0.35rem 0.8rem; font-size: 0.8rem;">
                <%= sub.action_type == "create_new" ? "Review Sheet" : "Review Updates" %> &rarr;
              </a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
