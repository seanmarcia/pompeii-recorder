<style>
  .login-wrapper {
    max-width: 440px;
    margin: 3rem auto;
  }
  .login-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    box-shadow: 0 16px 40px rgba(40, 25, 12, 0.18);
  }
  .login-header-text {
    text-align: center;
    margin-bottom: 2rem;
  }
  .login-header-text h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    color: var(--terracotta);
    margin-top: 0.5rem;
  }
  .login-header-text p {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.25rem;
  }
  .login-form-group {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .login-form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .login-form-group input {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    color: var(--text);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .login-form-group input:focus {
    border-color: var(--terracotta);
  }
  .login-submit-btn {
    width: 100%;
    margin-top: 1rem;
    padding: 0.85rem;
    font-size: 0.95rem;
    justify-content: center;
  }
  .login-hints {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.5;
  }
  .login-hints code {
    background: var(--surface-elevated);
    color: var(--accent);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
  }
</style>

<div class="login-wrapper">
  <div class="login-card">
    <div class="login-header-text">
      <div style="font-size: 2.2rem; line-height: 1;">&#9928;</div>
      <h2>Admin Sign In</h2>
      <p>Pompeii Archaeological Curation</p>
    </div>

    <%= form_with url: admin_login_path, method: :post do |f| %>
      <div class="login-form-group">
        <label for="login">Username or Email</label>
        <input type="text" name="login" id="login" placeholder="admin or admin@pompeii.org" required autofocus autocomplete="username" />
      </div>

      <div class="login-form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" placeholder="••••••••" required autocomplete="current-password" />
      </div>

      <button type="submit" class="btn btn-terracotta login-submit-btn">
        Authenticate &amp; Enter Dashboard &rarr;
      </button>
    <% end %>
  </div>
</div>
