<style>
  .catalog-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .catalog-head h2 { font-family: var(--font-serif); font-size: 1.75rem; }
  .catalog-head p { color: var(--text-muted); font-size: 0.9rem; }

  .search-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--terracotta);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 1px 3px rgba(60, 40, 20, 0.1);
  }
  .search-row { display: flex; gap: 0.75rem; }
  .search-input-wrap { position: relative; flex: 1; }
  .search-input-wrap::before {
    content: "⌕"; position: absolute; left: 0.9rem; top: 50%; transform: translateY(-52%);
    font-size: 1.3rem; color: var(--text-muted); pointer-events: none;
  }
  .search-input {
    width: 100%; padding: 0.75rem 1rem 0.75rem 2.4rem; font-size: 1rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: #fff; color: var(--text);
    font-family: inherit;
  }
  .search-input:focus { outline: none; border-color: var(--terracotta); box-shadow: 0 0 0 3px rgba(138, 59, 30, 0.12); }
  .search-help { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem; }
  .search-help code { background: var(--surface-elevated); border-radius: 4px; padding: 0 0.3rem; font-size: 0.78rem; }

  .filter-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.75rem; margin-top: 1rem; }
  .filter-row label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .filter-row select {
    padding: 0.5rem 0.6rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: #fff; color: var(--text); font-size: 0.9rem; font-family: inherit;
    text-transform: none; letter-spacing: 0; font-weight: 400;
  }
  .filter-row select.is-set { border-color: var(--terracotta); background: rgba(138, 59, 30, 0.05); }

  .result-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.75rem; color: var(--text-muted); font-size: 0.9rem; }
  .result-bar strong { color: var(--text); }
  .clear-link { color: var(--terracotta); font-weight: 600; text-decoration: none; margin-left: 0.5rem; }
  .clear-link:hover { text-decoration: underline; }

  #catalog-results { transition: opacity 0.15s ease; }
  #catalog-results.is-loading { opacity: 0.55; }
  .catalog-table-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow-x: auto; }
  .catalog-table { width: 100%; border-collapse: collapse; }
  .catalog-table th {
    text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);
    padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); background: var(--surface-elevated); white-space: nowrap;
  }
  .catalog-table td { padding: 0.85rem 1rem; border-bottom: 1px solid #eadfca; vertical-align: top; }
  .catalog-table tbody tr { cursor: pointer; transition: background 0.1s ease; }
  .catalog-table tbody tr:hover { background: #fbf1d8; }
  .catalog-table tbody tr:last-child td { border-bottom: none; }
  .sheet-tag { font-family: monospace; font-weight: 700; font-size: 0.85rem; color: #7a5228; background: var(--surface-elevated); padding: 0.15rem 0.5rem; border-radius: 4px; white-space: nowrap; }
  .loc { font-weight: 600; white-space: nowrap; }
  .loc-empty, .muted { color: var(--text-muted); }
  .room-title { font-weight: 600; color: var(--text); text-decoration: none; }
  .room-title:hover { color: var(--terracotta); }
  .structure { color: var(--text-muted); font-size: 0.9rem; }
  .snippet { color: var(--text-muted); font-size: 0.85rem; margin-top: 0.2rem; max-width: 60ch; }
  .type-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .type-tag { font-size: 0.75rem; font-weight: 600; border-radius: 999px; padding: 0.1rem 0.55rem; background: rgba(138, 59, 30, 0.1); color: #6c2c14; white-space: nowrap; }
  .type-tag.cat { background: rgba(165, 114, 63, 0.16); color: #6c4a26; }
  .people { font-size: 0.85rem; white-space: nowrap; }
  mark { background: #f6dd9a; color: inherit; border-radius: 2px; padding: 0 1px; }

  .empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); }
  .empty-state strong { display: block; color: var(--text); font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: 0.3rem; }

  .pager { display: flex; justify-content: center; align-items: center; gap: 0.35rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .pager a, .pager span { min-width: 2.2rem; text-align: center; padding: 0.4rem 0.65rem; border-radius: var(--radius); font-size: 0.875rem; font-weight: 600; text-decoration: none; color: var(--text); border: 1px solid var(--border); background: var(--surface); }
  .pager a:hover { border-color: var(--terracotta); color: var(--terracotta); }
  .pager .current { background: var(--terracotta); border-color: var(--terracotta); color: #fff; }
  .pager .gap { border: none; background: none; color: var(--text-muted); }

  @media (max-width: 700px) {
    .search-row { flex-direction: column; }
    .col-people, .col-types { display: none; }
  }
</style>

<% mark = ->(text) { @terms.any? ? highlight(h(text.to_s), @terms) : text.to_s } %>
<% link_params = ->(changes = {}) { { q: @query.presence, sort: (@sort if @sort != "location"), **@filters }.merge(changes).compact } %>
<% filtered = @query.present? || @filters.values.any? %>

<div class="catalog-head">
  <div>
    <h2>Master Sheets</h2>
    <p>Browse and search every saved catalog sheet. Viewing never changes a sheet.</p>
  </div>
</div>

<%= form_with url: admin_features_path, method: :get, class: "search-card", id: "catalog-search",
              data: { controller: "auto-submit", turbo_frame: "catalog-results", turbo_action: "replace",
                      action: "input->auto-submit#input change->auto-submit#change submit->auto-submit#cancelDebounce" } do |form| %>
  <div class="search-row">
    <div class="search-input-wrap">
      <%= form.search_field :q, value: @query, class: "search-input", autofocus: @query.blank?,
            placeholder: "Search sheets, rooms, descriptions, people…", "aria-label": "Search master sheets" %>
    </div>
    <%= form.submit "Search", class: "btn btn-terracotta", name: nil %>
  </div>
  <p class="search-help">
    Every word must match, e.g. <code>dolium counter</code>. Use quotes for a phrase: <code>"painted lararium"</code>.
    Search a location with <code>VI.17.42</code> or <code>VI 17</code>.
  </p>
  <div class="filter-row">
    <% { region: "Region", sheet_type: "Sheet type", category: "Category", person: "Person" }.each do |key, label| %>
      <label>
        <%= label %>
        <%= select_tag key, options_for_select(@options[key], @filters[key]), include_blank: "Any",
              class: ("is-set" if @filters[key]) %>
      </label>
    <% end %>
    <label>
      Sort by
      <%= select_tag :sort, options_for_select(Admin::FeaturesController::SORTS.invert, @sort) %>
    </label>
  </div>
<% end %>

<% # The results live in a Turbo Frame the search form targets: the form
   # submits stay on this page and Turbo swaps the frame (issue #78). The
   # auto-submit controller keeps the search live as you type. %>
<%= turbo_frame_tag "catalog-results", "aria-live": "polite" do %>
  <%= render "results" %>
<% end %>
