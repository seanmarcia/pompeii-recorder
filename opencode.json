{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--output-dir",
          "tmp/.playwright-mcp",
          "--output-max-size",
          "10485760"
        ]
      }
    }
  }
}
